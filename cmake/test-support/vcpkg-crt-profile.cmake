# Execute the real port until its configure boundary. Downloads, source patches,
# compilation and installation are test doubles; linkage policy is vcpkg's own.
cmake_minimum_required(VERSION 3.30)
foreach(_required REPO_ROOT VCPKG_ROOT_DIR FIXTURE_DIR PROFILE_PORT PROFILE_CRT PROFILE_ARCH)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
set(PORT "${PROFILE_PORT}")
set(VCPKG_TARGET_IS_WINDOWS TRUE)
set(VCPKG_TARGET_ARCHITECTURE "${PROFILE_ARCH}")
set(VCPKG_CRT_LINKAGE "${PROFILE_CRT}")
set(VCPKG_LIBRARY_LINKAGE "${PROFILE_CRT}")
set(TARGET_TRIPLET "${PROFILE_ARCH}-windows")
set(VERSION 4.12.0)
set(FEATURES core dnn contrib fs calib3d intrinsics zlib)
set(CURRENT_BUILDTREES_DIR "${FIXTURE_DIR}/buildtrees")
set(CURRENT_PACKAGES_DIR "${FIXTURE_DIR}/packages")
set(CURRENT_INSTALLED_DIR "${VCPKG_ROOT_DIR}/installed/dynamic/x64-windows")
set(DOWNLOADS "${FIXTURE_DIR}/downloads")
file(MAKE_DIRECTORY "${CURRENT_BUILDTREES_DIR}" "${FIXTURE_DIR}/source/third_party/zlib"
    "${FIXTURE_DIR}/source/third_party/mini_chromium/mini_chromium")
file(WRITE "${FIXTURE_DIR}/source/third_party/mini_chromium/mini_chromium/BUILD.gn" "")
include("${VCPKG_ROOT_DIR}/scripts/cmake/vcpkg_check_linkage.cmake")
include("${VCPKG_ROOT_DIR}/scripts/cmake/vcpkg_check_features.cmake")

function(vcpkg_download_distfile output)
    set(${output} "${DOWNLOADS}/unused" PARENT_SCOPE)
endfunction()
function(vcpkg_from_github)
    cmake_parse_arguments(PARSE_ARGV 0 _source "" "OUT_SOURCE_PATH" "")
    set(${_source_OUT_SOURCE_PATH} "${FIXTURE_DIR}/source" PARENT_SCOPE)
endfunction()
function(vcpkg_from_git)
    vcpkg_from_github(${ARGV})
    set(${ARGV1} "${FIXTURE_DIR}/source" PARENT_SCOPE)
endfunction()
function(vcpkg_find_acquire_program output)
    set(${output} "${CMAKE_COMMAND}" PARENT_SCOPE)
endfunction()
function(x_vcpkg_get_python_packages)
endfunction()
function(vcpkg_replace_string)
endfunction()
function(vcpkg_cmake_get_vars output)
    # Model vcpkg's compiler probe result, including the paths GN must escape.
    if(VCPKG_CRT_LINKAGE STREQUAL "dynamic")
        set(_crt MD)
    else()
        set(_crt MT)
    endif()
    set(_vars "${FIXTURE_DIR}/compiler-vars.cmake")
    file(WRITE "${_vars}" "")
    foreach(_language C CXX)
        file(APPEND "${_vars}"
            "set(VCPKG_COMBINED_${_language}_FLAGS_DEBUG [==[/${_crt}d /GL /I\"C:\\SDK path\\include\"]==])\n"
            "set(VCPKG_COMBINED_${_language}_FLAGS_RELEASE [==[/${_crt} /GL /I\"C:\\SDK path\\include\"]==])\n")
    endforeach()
    set(${output} "${_vars}" PARENT_SCOPE)
endfunction()

function(check_configure kind)
    if(NOT VCPKG_CRT_LINKAGE STREQUAL PROFILE_CRT)
        message(FATAL_ERROR "${PORT}: CRT changed from ${PROFILE_CRT} to ${VCPKG_CRT_LINKAGE}")
    endif()
    if(NOT VCPKG_LIBRARY_LINKAGE STREQUAL "static")
        message(FATAL_ERROR "${PORT}: native library must remain static")
    endif()
    cmake_parse_arguments(PARSE_ARGV 1 _configure "" "SOURCE_PATH"
        "OPTIONS;OPTIONS_DEBUG;OPTIONS_RELEASE;MAYBE_UNUSED_VARIABLES")
    if(PROFILE_CRT STREQUAL "dynamic")
        set(_static 0)
        set(_crt MD)
        set(_suffix DLL)
    else()
        set(_static 1)
        set(_crt MT)
        set(_suffix "")
    endif()
    if(PORT STREQUAL "opencv4" AND
       NOT "-DBUILD_WITH_STATIC_CRT=${_static}" IN_LIST _configure_OPTIONS)
        message(FATAL_ERROR "OpenCV's CRT option does not match ${PROFILE_CRT}")
    endif()
    foreach(_configuration DEBUG RELEASE)
        if(_configuration STREQUAL "DEBUG")
            set(_debug Debug)
            set(_flag "/${_crt}d")
        else()
            set(_debug "")
            set(_flag "/${_crt}")
        endif()
        foreach(_option IN LISTS _configure_OPTIONS _configure_OPTIONS_${_configuration})
            if(_option MATCHES "^-DCMAKE_MSVC_RUNTIME_LIBRARY=(.*)$" AND
               NOT CMAKE_MATCH_1 STREQUAL "MultiThreaded${_debug}${_suffix}")
                message(FATAL_ERROR "${PORT}: incompatible ${_configuration} CRT override ${_option}")
            endif()
        endforeach()
        if(kind STREQUAL "GN")
            string(FIND "${_configure_OPTIONS_${_configuration}}" "${_flag} " _found)
            if(_found LESS 0)
                message(FATAL_ERROR "Crashpad lost the ${_configuration} ${_flag} compiler flag")
            endif()
            if(NOT "${_configure_OPTIONS_${_configuration}}" MATCHES "/GL-")
                message(FATAL_ERROR "Crashpad must keep its LTCG isolation")
            endif()
        endif()
    endforeach()
endfunction()

macro(vcpkg_cmake_configure)
    check_configure(CMake ${ARGV})
    set(_configured TRUE)
    return()
endmacro()
macro(vcpkg_gn_configure)
    check_configure(GN ${ARGV})
    set(_configured TRUE)
    return()
endmacro()
if(NOT DEFINED OVERLAY_ROOT)
    set(OVERLAY_ROOT "${REPO_ROOT}/cmake/vcpkg-overlay-ports")
endif()
include("${OVERLAY_ROOT}/${PORT}/portfile.cmake")
if(NOT _configured)
    message(FATAL_ERROR "${PORT}: configure boundary was not reached")
endif()
message(STATUS "${PORT} ${PROFILE_ARCH} ${PROFILE_CRT}: CRT profile preserved")
