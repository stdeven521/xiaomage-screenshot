+    // These optional descriptor properties were introduced in macOS 27.
+    // Older translators reject the fields even when they hold default values.
+    // Omitting them preserves the runtime's default pipeline descriptor and
+    // keeps both the portable IR and GPU-specific native archive enabled.
+    if sdk_major < 27 {
+        for pipeline in &mut native_pipelines {
+            for field in [
