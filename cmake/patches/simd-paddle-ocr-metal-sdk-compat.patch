+                "forward_progress_usage",
+                "contention_relief",
+            ] {
+                pipeline.as_object_mut().unwrap().remove(field);
+            }
+        }
+    }
+    let script = serde_json::to_string(&serde_json::json!({
+        "libraries":{"paths":[{"label":"OCR", "path":out.join("ocr.metallib")}]},
